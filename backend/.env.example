DATABASE_URL=postgresql+asyncpg://hrmind:hrmind@localhost:5433/hrmind
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
ROUTER_THRESHOLD=0.75
TOP_K=30
RERANK_TOP_K=5
MAX_HISTORY=20
MAX_CONTEXT=8
SUMMARY_TRIGGER=12
SQL_CACHE_TTL=60
RETRIEVAL_CACHE_TTL=1800
PLAN_CACHE_TTL=900
MAX_PLAN_NODES=12
TOOL_TIMEOUT_MS=15000
SQL_MAX_ROWS=200
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
APP_ENV=development
LOG_LEVEL=INFO
